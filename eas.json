{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://epsea.ineansastem.com/agro-test/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://epsea.ineansastem.com/agro/api/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "epsea@unicordoba.edu.co",
        "EXPO_PUBLIC_WEBSITE_URL": "https://www.unicordoba.edu.co",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://www.unicordoba.edu.co/epsea/politica-de-privacidad"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "language": "es-MX"
      }
    }
  }
}
